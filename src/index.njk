---
title: "Friends of Hall Football — West Hartford, CT"
active: home
layout: base.njk
permalink: index.html
---

<section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1>{{ pages.hero.headline }}</h1>
        <p>{{ pages.hero.body }}</p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="donate.html">{{ pages.hero.primaryButton }}</a>
          <a class="btn btn--white" href="{{ site.storeUrl }}" target="_blank" rel="noopener">{{ pages.hero.secondaryButton }} <svg class="external-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"></path><path d="M20 4 11 13"></path><path d="M19 15v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4"></path></svg></a>
        </div>
      </div>
      <div class="hero-photo"><img src="{{ pages.hero.image | asset }}" alt="Hall Titans on the sideline"></div>
    </div>
  </section>

  <section class="sponsor-band">
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2>{{ pages.sponsorBand.heading }}</h2>
        <div class="sponsor-actions">
          <a class="btn btn--outline btn--small" href="sponsors.html">See All Sponsors</a>
          <a class="btn btn--primary btn--small" href="sponsors.html#levels">Become a Sponsor</a>
        </div>
      </div>
      <div class="sponsor-grid">
        {% for s in sponsors.list %}
        <div class="sponsor-tile">{% if s.website %}<a href="{{ s.website }}" target="_blank" rel="noopener">{% endif %}<img src="{{ s.logo | asset }}" alt="{{ s.name }}">{% if s.website %}</a>{% endif %}</div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="section wrap" id="schedule">
    <div class="section-head">
      <h2>{{ pages.scheduleSection.nextUpHeading }}</h2>
      <span class="section-note" style="margin:0">{{ pages.scheduleSection.nextUpNote }}</span>
    </div>
    <div class="next-game">
      <div class="next-game-panel">
        <div class="next-game-kicker">{{ nextGame.kicker }}</div>
        <div class="next-game-title">{{ nextGame.title }}</div>
        <div class="next-game-info">
          <div>
            <div class="info-label">Kickoff</div>
            <div class="info-value">{{ nextGame.time }}</div>
          </div>
          <div>
            <div class="info-label">Where</div>
            <div class="info-value">{{ nextGame.site | safe }}</div>
          </div>
          {% if nextGame.bus %}
          <div>
            <div class="info-label">Bus Leaves</div>
            <div class="info-value">{{ nextGame.bus }}</div>
          </div>
          {% endif %}
        </div>
      </div>
      <div class="next-game-photo"><img src="{{ pages.scheduleSection.nextUpImage | asset }}" alt="Hall Titans team photo"></div>
    </div>
  </section>

  <section class="section section--tight wrap">
    <div class="section-head">
      <h3 style="font-size:32px;color:var(--navy)">{{ pages.scheduleSection.fullHeading }}</h3>
      <a class="inline-link" href="{{ site.ciacUrl }}" target="_blank" rel="noopener">View on CIAC <svg class="external-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"></path><path d="M20 4 11 13"></path><path d="M19 15v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4"></path></svg></a>
    </div>
    <div class="schedule">
      <div class="schedule-head">
        <div>Date</div>
        <div>Time</div>
        <div>Opponent</div>
        <div>Site</div>
      </div>
        {% for g in schedule.games %}
        <div class="game-row{% if g.home %} is-home{% endif %}">
          <div class="game-date">{{ g.date }}</div>
          <div class="game-time">{{ g.time }}</div>
          <div class="game-opponent"><strong>{{ g.opponent }}</strong><span class="game-tag">{{ g.type }}</span></div>
          <div class="game-site">{{ g.site }}</div>
        </div>
        {% endfor %}
    </div>
    <p class="section-note">Dates and times occasionally change. The <a href="{{ site.ciacUrl }}" target="_blank" rel="noopener">official CIAC schedule</a> is always the source of record.</p>
  </section>


<section class="section section--wash">
    <div class="wrap">
    <div class="newsletter-band">
      <div>
        <div class="eyebrow">{{ pages.newsletterBand.eyebrow }}</div>
        <h2>{{ pages.newsletterBand.heading }}</h2>
        <p>{{ pages.newsletterBand.body }}</p>
        <div class="hero-actions" style="margin-top:26px">
          <a class="btn btn--outline" href="newsletter.html">{{ pages.newsletterBand.button }}</a>
        </div>
      </div>
      <div class="newsletter-cover"><img src="{{ pages.newsletterBand.image | asset }}" alt="Hall Quarterly newsletter cover"></div>
    </div>
    </div>
  </section>

    <section class="section wrap">
    <div class="social-band">
      <div class="social-band-copy">
        <h2>{{ pages.socialBand.heading }}</h2>
        <p>{{ pages.socialBand.body }}</p>
      </div>
      <div class="social-cards">
        {% for p in socialPlatforms %}{% if site[p.urlKey] %}
        <a class="social-card social-card--{{ p.key }}" href="{{ site[p.urlKey] }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">{{ p.icon | safe }}</svg>
          <span class="social-card-name">{{ p.label }}</span>
          <span class="social-card-go">Follow &rarr;</span>
        </a>
        {% endif %}{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="wrap volunteer-band">
      <div>
        <h2 style="color:#fff">{{ pages.volunteer.heading }}</h2>
        <p>{{ pages.volunteer.body }}</p>
        <div style="margin-top:28px">
          <div class="contact-label">Questions?</div>
          <div style="margin-top:6px;color:#d3e0ee">{{ site.contactEmail }}</div>
        </div>
      </div>
      <div class="volunteer-cta">
        <a class="btn btn--primary" href="volunteer.html">{{ pages.volunteer.button }}</a>
      </div>
    </div>
  </section>

  <section class="section wrap" id="news">
      <div class="section-head">
        <h2>{{ pages.newsSection.heading }}</h2>
              </div>
      <div class="news-grid">
        {% for post in collections.posts | reverse %}
        <article class="post-card">
          {% if post.data.image %}<div class="post-card-photo"><img src="{{ post.data.image | asset }}" alt=""></div>{% endif %}
          <div class="post-card-body">
            <div class="post-date">{{ post.data.date | postDate }}</div>
            <h3>{{ post.data.title }}</h3>
            {{ post.content | safe }}
            <a class="post-more" href="{{ post.url }}">Read more &rarr;</a>
          </div>
        </article>
        {% endfor %}
      </div>
  </section>

