<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>

{# Per-page description comes from CMS -> Page Text -> Search & Sharing.
   Falls back to the site tagline if a page has no entry. #}
{% set metaDesc = description or (seoKey and pages.seo[seoKey]) or site.description %}
{% set baseUrl = site.url %}
{% set pageUrl = page.url | absoluteUrl(site.url) %}
{% set shareImg = shareImage or image or site.shareImage or pages.hero.image %}

<meta name="description" content="{{ metaDesc }}">
<link rel="canonical" href="{{ pageUrl }}">
{% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}

<meta property="og:type" content="{% if layout == "post.njk" %}article{% else %}website{% endif %}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ metaDesc }}">
<meta property="og:url" content="{{ pageUrl }}">
{% if shareImg %}<meta property="og:image" content="{{ baseUrl }}{{ shareImg }}">
<meta property="og:image:alt" content="{{ site.name }}">{% endif %}
<meta property="og:locale" content="en_US">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ metaDesc }}">
{% if shareImg %}<meta name="twitter:image" content="{{ baseUrl }}{{ shareImg }}">{% endif %}

<link rel="icon" href="/assets/titans-logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
</head>
<body>
<!-- SHARED NAV START — keep this block identical on every page -->
  <div class="topbar">
    <span>A 501(c)(3) booster club supporting William H. Hall High School football in West Hartford, CT.</span>
  </div>

  <header class="site-header">
    <input class="nav-toggle" type="checkbox" id="nav-toggle" aria-label="Open menu">
    <div class="header-inner">
      <a class="brand" href="/index.html">
        <img src="/assets/titans-logo.png" alt="William H Hall Titans">
        <span class="brand-text">
          <span class="brand-sub">Friends of</span>
          <span class="brand-name">Hall Football</span>
        </span>
      </a>

      <nav class="nav">
        {% for item in nav.items %}{% if item.visible %}{% set href = (item.siteKey and site[item.siteKey] or item.url) | siteLink %}{% if href %}
        <a class="nav-link{% if item.key and active == item.key %} is-active{% endif %}" href="{{ href }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}>{{ item.label }}{% if item.external %} <svg class="external-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"></path><path d="M20 4 11 13"></path><path d="M19 15v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4"></path></svg>{% endif %}</a>
        {% endif %}{% endif %}{% endfor %}
        <a class="nav-donate" href="/donate.html">Donate</a>
      </nav>

      <div class="mobile-bar">
        <a class="nav-donate" href="/donate.html">Donate</a>
        <label class="nav-burger" for="nav-toggle"><span></span><span></span><span></span></label>
      </div>
    </div>

    <div class="nav-panel">
      {% for item in nav.items %}{% if item.visible %}{% set href = (item.siteKey and site[item.siteKey] or item.url) | siteLink %}{% if href %}
      <a href="{{ href }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}>{{ item.label }}{% if item.external %} <svg class="external-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"></path><path d="M20 4 11 13"></path><path d="M19 15v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4"></path></svg>{% endif %}</a>
      {% endif %}{% endif %}{% endfor %}
    </div>
  </header>
  <!-- SHARED NAV END -->

{{ content | safe }}

<!-- SHARED FOOTER START — keep this block identical on every page -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div>Friends of Hall Football · West Hartford, Connecticut</div>
      <div class="footer-links">
        <a href="/donate.html">Donate</a>
        <a href="/newsletter.html">Newsletter</a>
        <a href="/sponsors.html">Sponsors</a>
      <a href="/volunteer.html">Volunteer</a>
        <a href="{{ site.storeUrl }}" target="_blank" rel="noopener">Team Store <svg class="external-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"></path><path d="M20 4 11 13"></path><path d="M19 15v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4"></path></svg></a>
        {% for p in socialPlatforms %}{% if site[p.urlKey] %}<a href="{{ site[p.urlKey] }}" target="_blank" rel="noopener">{{ p.label }} <svg class="external-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"></path><path d="M20 4 11 13"></path><path d="M19 15v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4"></path></svg></a>{% endif %}{% endfor %}
      </div>
    </div>
  </footer>
  <!-- SHARED FOOTER END -->

<script>
// The mobile menu is a CSS checkbox toggle, so it stays open when a link only
// jumps to an anchor on the same page (#schedule, #news) instead of loading a
// new page. Close it explicitly whenever a menu link is tapped.
(function () {
  var toggle = document.getElementById("nav-toggle");
  var panel = document.querySelector(".nav-panel");
  if (!toggle || !panel) return;
  panel.addEventListener("click", function (e) {
    if (e.target.closest("a")) toggle.checked = false;
  });
  // Also close on Escape, and when tapping outside the menu.
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") toggle.checked = false;
  });
  document.addEventListener("click", function (e) {
    if (!toggle.checked) return;
    // A label click also fires a second click on the checkbox itself; ignore
    // that one or the menu would close the instant it opened.
    if (e.target === toggle) return;
    if (e.target.closest(".nav-panel") || e.target.closest(".nav-burger")) return;
    toggle.checked = false;
  });
})();
</script>

<div class="sponsor-modal" id="sponsor-modal" hidden>
  <div class="sponsor-modal-backdrop" data-close></div>
  <div class="sponsor-modal-card" role="dialog" aria-modal="true" aria-labelledby="sponsor-modal-name">
    <button type="button" class="sponsor-modal-close" data-close aria-label="Close">&times;</button>
    <div class="sponsor-modal-logo"></div>
    <h3 id="sponsor-modal-name"></h3>
    <a class="btn btn--primary sponsor-modal-visit" href="#" target="_blank" rel="noopener">Visit Website</a>
    <p class="sponsor-modal-text"></p>
  </div>
</div>

<script>
// Sponsor strip: weighted shuffle + optional detail card.
//
// Order is randomised on every page load so no sponsor is permanently last.
// Higher levels get more "tickets" (data-weight) so they land near the top
// more often, but it is a lottery, not a guarantee - any sponsor can lead.
(function () {
  var grids = document.querySelectorAll(".sponsor-grid");
  if (!grids.length) return;

  function weightedShuffle(tiles) {
    var pool = tiles.slice();
    var out = [];
    while (pool.length) {
      var total = 0, i;
      for (i = 0; i < pool.length; i++) {
        total += Math.max(1, parseInt(pool[i].getAttribute("data-weight"), 10) || 1);
      }
      var pick = Math.random() * total, running = 0, chosen = pool.length - 1;
      for (i = 0; i < pool.length; i++) {
        running += Math.max(1, parseInt(pool[i].getAttribute("data-weight"), 10) || 1);
        if (pick < running) { chosen = i; break; }
      }
      out.push(pool.splice(chosen, 1)[0]);
    }
    return out;
  }

  grids.forEach(function (grid) {
    var tiles = Array.prototype.slice.call(grid.querySelectorAll(".sponsor-tile"));
    if (tiles.length < 2) return;
    weightedShuffle(tiles).forEach(function (t) { grid.appendChild(t); });
  });

  // Detail card, shown only for sponsors that have a description written.
  var modal = document.getElementById("sponsor-modal");
  if (!modal) return;
  var nameEl = modal.querySelector("#sponsor-modal-name");
  var textEl = modal.querySelector(".sponsor-modal-text");
  var logoBox = modal.querySelector(".sponsor-modal-logo");
  var visitEl = modal.querySelector(".sponsor-modal-visit");
  var lastFocus = null;

  function open(tile) {
    nameEl.textContent = tile.getAttribute("data-name") || "";
    textEl.textContent = tile.getAttribute("data-description") || "";
    // The image is created on open so the page never loads an empty <img>.
    logoBox.innerHTML = "";
    var src = tile.getAttribute("data-logo");
    if (src) {
      var img = document.createElement("img");
      img.src = src;
      img.alt = tile.getAttribute("data-name") || "";
      logoBox.appendChild(img);
    }
    var site = tile.getAttribute("data-website");
    if (site) { visitEl.href = site; visitEl.hidden = false; }
    else { visitEl.hidden = true; }
    lastFocus = document.activeElement;
    modal.hidden = false;
    document.body.style.overflow = "hidden";
    modal.querySelector(".sponsor-modal-close").focus();
  }

  function close() {
    modal.hidden = true;
    document.body.style.overflow = "";
    if (lastFocus) lastFocus.focus();
  }

  document.addEventListener("click", function (e) {
    var tile = e.target.closest(".sponsor-tile[data-description]");
    if (tile) { e.preventDefault(); open(tile); return; }
    if (e.target.closest("[data-close]")) close();
  });

  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && !modal.hidden) close();
  });
})();
</script>
</body>
</html>
