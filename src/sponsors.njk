---
title: "Sponsors — Friends of Hall Football"
active: sponsors
layout: base.njk
seoKey: sponsors
permalink: sponsors.html
---

<section class="page-hero">
    <div class="wrap">
      <h1>Our Sponsors</h1>
      <p>Local businesses and families keep this program running — uniforms, meals, equipment, and travel. We are grateful to every one of them, and we would love to add your name to this page.</p>
    </div>
  </section>

  <section class="section wrap">
    <h2>Thank You</h2>
    <p class="section-lede" style="margin-top:8px">Every sponsor below supports Hall football this season.</p>
    <div class="sponsor-grid sponsor-grid--page">
      {% for sp in sponsors.list %}
      <div class="sponsor-tile" data-weight="{{ sp.tier | tierWeight(sponsorLevels.levels) }}"{% if sp.description %} data-name="{{ sp.name }}" data-description="{{ sp.description }}" data-logo="{{ sp.logo | asset }}" data-website="{{ sp.website }}"{% endif %}>{% if sp.website or sp.description %}<a href="{{ sp.website or '#' }}"{% if sp.website %} target="_blank" rel="noopener"{% endif %}>{% endif %}<img src="{{ sp.logo | asset }}" alt="{{ sp.name }}">{% if sp.website or sp.description %}</a>{% endif %}</div>
      {% endfor %}
    </div>
  </section>

  <section class="section section--wash" id="levels">
    <div class="wrap">
      <h2>Sponsorship Levels</h2>
      <p class="section-lede" style="margin-top:10px">Every level keeps a Titan on the field. Sponsors are recognized on this page and at home games.</p>
      <div class="tiers">
        {% for t in sponsorLevels.levels %}
        <div class="tier tier--{{ t.slug }}">
          <div class="tier-name">{{ t.name }}</div>
          <div class="tier-amount">${{ t.amount }}</div>
          <ul>{% if t.benefits is string %}<li>{{ t.benefits }}</li>{% else %}{% for b in t.benefits %}<li>{{ b }}</li>{% endfor %}{% endif %}</ul>
        </div>
        {% endfor %}
      </div>

      <div class="levels-cta">
        <div class="levels-cta-copy">
          <h3>{{ pages.sponsorsPage.ctaHeading or "Ready to Sponsor?" }}</h3>
          <p>{{ pages.sponsorsPage.ctaBody or "Pick your level and complete your sponsorship online. It takes about a minute, and you will get an emailed receipt for your records." }}</p>
        </div>
        <a class="btn btn--primary btn--large" href="/sponsor-donate.html">{{ pages.sponsorsPage.ctaButton or "Become a Sponsor" }}</a>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div>
        <h2>Questions?</h2>
        <p class="section-lede" style="margin-top:16px">Not sure which level fits, want to donate goods or services instead of cash, or prefer to pay by check? Send us a note and a board member will get back to you.</p>
        <div>
          <div class="side-meta-label">Email</div>
          <div class="side-meta-value">{{ site.contactEmail }}</div>
        </div>
      </div>
      <div class="card card--outline">
        <h3>Ask a Question</h3>
        <form class="card-form" method="POST" name="sponsor-inquiry" data-netlify="true" netlify-honeypot="bot-field" action="/sponsor-thanks.html">
          <input type="hidden" name="form-name" value="sponsor-inquiry">
          <p class="hidden-field"><label>Leave this field empty <input name="bot-field"></label></p>
          <label class="field">Business or family name
            <input type="text" name="business" placeholder="Main Street Hardware" required>
          </label>
          <label class="field">Email
            <input type="email" name="email" placeholder="you@email.com" required>
          </label>
          <label class="field">How can we help?
            <textarea name="message" rows="4" placeholder="Ask about a level, offer goods or services, or tell us how you would like to help." required></textarea>
          </label>
          <button class="btn btn--primary btn--block" type="submit">Send Question</button>
        </form>
      </div>
    </div>
  </section>
