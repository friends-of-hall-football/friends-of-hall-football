---
title: "Volunteer — Friends of Hall Football"
active: volunteer
layout: base.njk
permalink: volunteer.html
---

  <section class="section wrap">
    <div class="section-head"><h2>{{ pages.volunteerPage.heading }}</h2></div>
    <p class="section-lede">{{ pages.volunteerPage.intro }}</p>

    <div class="signup-list">
      {% if pages.volunteerPage.signupLinks and pages.volunteerPage.signupLinks.length %}
      <ul>
        {% for link in pages.volunteerPage.signupLinks %}
        {% if link.url %}<li><a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label or link.url }}</a></li>{% endif %}
        {% endfor %}
      </ul>
      {% endif %}
    </div>

    <div class="side-card" style="margin-top:36px">
      <h3>Another Way to Help?</h3>
      <p>{{ pages.volunteerPage.closing }}</p>
      <div class="link-stack">
        <a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a>
      </div>
    </div>
  </section>
