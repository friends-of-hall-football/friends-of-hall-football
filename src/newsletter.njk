---
title: "Newsletter — Friends of Hall Football"
active: newsletter
layout: base.njk
permalink: newsletter.html
---

<section class="page-hero">
    <div class="wrap">
      <div class="eyebrow" style="color:#7fb2ee">Hall Quarterly</div>
      <h1 style="margin-top:10px">The Newsletter</h1>
      <p>Every issue covers what the team is up to, who is being recognized, which fundraisers are coming up, and how your family can pitch in. Read it right here, or open the full version in a new tab.</p>
      <div class="hero-actions">
        <a class="btn btn--white" href="https://view.gogipper.com/page/4113254" target="_blank" rel="noopener">Open Full Issue ↗</a>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <h2 style="font-size:clamp(28px,6.5vw,38px)">Current Issue</h2>
    <div class="newsletter-frame" style="margin-top:20px">
      <iframe src="https://view.gogipper.com/page/4113254" title="Hall Quarterly Newsletter" loading="lazy"></iframe>
    </div>
    <p class="section-note">If the newsletter does not appear above, <a href="https://view.gogipper.com/page/4113254" target="_blank" rel="noopener">open it directly</a> — some browsers block embedded pages.</p>
  </section>

  <section class="section section--tight wrap">
    <h2 style="font-size:clamp(28px,6.5vw,38px)">Past Issues</h2>
    <div class="issue-grid" style="margin-top:22px">
      {% for issue in newsletterIssues.issues %}
      <article class="issue-card">
        <div class="issue-card-photo"><img src="{{ issue.image | asset }}" alt=""></div>
        <div class="issue-card-body">
          <div class="issue-season">{{ issue.season }}</div>
          <h3>{{ issue.title }}</h3>
          <a class="post-more" href="{{ issue.url or site.newsletterUrl }}">Read issue &rarr;</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
